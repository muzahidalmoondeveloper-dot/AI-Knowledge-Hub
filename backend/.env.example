APP_NAME=AI Knowledge Hub
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_knowledge_hub
# Generate using scripts/init_env.py; example secrets intentionally cannot start the app.
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_valid_fernet_key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PROVIDER_ORIGINS=["http://localhost:11434","http://127.0.0.1:11434","http://localhost:1234","http://localhost:8001","https://api.openai.com","https://api.anthropic.com","https://generativelanguage.googleapis.com","https://api.groq.com"]
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=20
COOKIE_SECURE=false
HISTORY_MESSAGES=12
HISTORY_CHARACTERS=24000
WORKER_LEASE_SECONDS=900
